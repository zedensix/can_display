#!/usr/bin/env bash
#MISE description="Build the Android Auto app's debug APK (android/app/build/outputs/apk/debug), the dash's firmware bundled in it to update the dash from the phone"
#MISE depends=["android:sdk"]
set -euo pipefail
"$(dirname "$0")/../firmware"
mkdir -p android/app/src/main/assets
cp build/firmware/firmware.bin android/app/src/main/assets/firmware.bin
gradle -p android --console=plain assembleDebug
