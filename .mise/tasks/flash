#!/usr/bin/env bash
#MISE description="Build and flash the firmware onto the Pico W, step by step (optional UF2, PORT)"
set -euo pipefail

volume=/Volumes/RPI-RP2
uf2="${UF2:-bin/firmware.uf2}"

echo "[1/4] building..."
"$(dirname "$0")/firmware" >/dev/null
echo "      built in ${SECONDS}s"

echo "[2/4] waiting for the Pico in BOOTSEL ($volume)..."
if [ ! -d "$volume" ]; then
  port="${PORT:-$( (ls /dev/cu.usbmodem* 2>/dev/null || true) | head -1)}"
  if [ -n "$port" ]; then
    echo "      asking the firmware running on $port to reboot into BOOTSEL"
    stty -f "$port" 1200 || echo "      couldn't open $port: close the serial monitor, or hold BOOTSEL while replugging"
  else
    echo "      no running Pico found: hold BOOTSEL while plugging it in"
  fi
fi
for _ in $(seq 60); do
  [ -d "$volume" ] && break
  sleep 1
done
[ -d "$volume" ] || { echo "      no $volume after 60s, giving up"; exit 1; }

echo "[3/4] copying $uf2 ($(du -h "$uf2" | cut -f1 | tr -d ' ')) to the Pico..."
# dd, not cp: macOS cp goes through copyfile, which the bootloader's fake
# FAT drive refuses. The Pico reboots as soon as it has the whole file,
# so dd can still fail on close after a good copy: the volume going away
# is the real check.
copied=true
dd if="$uf2" of="$volume/firmware.uf2" bs=64k status=progress || copied=false

echo "[4/4] waiting for the Pico to reboot..."
for _ in $(seq 15); do
  [ -d "$volume" ] || { echo "done in ${SECONDS}s"; exit 0; }
  sleep 1
done
if [ "$copied" = false ]; then
  echo "      the copy failed, see the error above"
else
  echo "      $volume is still mounted: the Pico rejected the file"
fi
exit 1
