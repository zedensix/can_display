#!/usr/bin/env bash
#MISE description="Convert 86.png into the boot splash, src/app/logo.c"
set -euo pipefail

mkdir -p build
go run ./cmd/logo 86.png build/logo.bin
{
  echo '// Generated by `mise run logo` from 86.png: big-endian uint16 width and'
  echo '// height, then 1-bit rows, MSB first, each padded to a byte.'
  echo
  (cd build && xxd -i -n logo_bin logo.bin) |
    sed 's/^unsigned char/const unsigned char/; s/^unsigned int/const unsigned int/'
} >src/app/logo.c
