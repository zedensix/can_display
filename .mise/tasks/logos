#!/usr/bin/env bash
#MISE description="Convert a folder of logos (logos/ by default) into the screensaver's, src/app/ui/brands_data.h: kept out of git"
#USAGE arg "[dir]" help="The folder of PNG logos, shown in the alphabetical order of their names (number them: 01-, 02-...)"
set -euo pipefail

dir="${usage_dir:-${1:-logos}}"
out=src/app/ui/brands_data.h
[ -d "$dir" ] || { echo "no folder $dir"; exit 1; }
mkdir -p build/logos
rm -f build/logos/*

# Each logo cropped to its inked pixels and fitted in 200 x 140.
names=()
while IFS= read -r file; do
  name=$(basename "$file" .png | sed 's/^[0-9]*-//' | tr -c 'A-Za-z0-9\n' '_' | tr 'A-Z' 'a-z')
  python3 tools/logo.py "$file" "build/logos/brand_$name" 200 140
  names+=("$name")
done < <(find "$dir" -maxdepth 1 -name '*.png' | LC_ALL=C sort)

{
  echo "// Generated by \`mise run logos\` from $dir, kept out of git (the logos are"
  echo '// their makers'"'"' trademarks): brands.c includes it when it exists.'
  echo
  for name in "${names[@]}"; do
    (cd build/logos && xxd -i -n "brand_$name" "brand_$name") |
      sed 's/^unsigned char/static const unsigned char/; /^unsigned int/d'
    echo
  done
  echo "const brand_t brands[] = {"
  for name in "${names[@]}"; do
    echo "    {\"$(echo "$name" | tr 'a-z_' 'A-Z ')\", brand_$name},"
  done
  [ ${#names[@]} -eq 0 ] && echo "    {0},"
  echo "};"
  echo "const int brand_count = ${#names[@]};"
} >"$out"
# The builds track brands.c, not a header that wasn't there when they last ran.
touch src/app/ui/brands.c
echo "${#names[@]} logos from $dir -> $out"
