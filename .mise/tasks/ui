#!/usr/bin/env bash
#MISE description="Render the UI's screens with fixed readings into screenshots/pico/*.png (sheet.png: all of them)"
set -euo pipefail

# Start clean: a screen dropped from pico/tools/render_ui_shots.c leaves no stale PNG.
rm -rf build/ui screenshots/pico/*.png
mkdir -p build/ui
cc -std=c11 -Wall -Wextra -Werror -DBRANDS_NONE -Ipico/src/app -o build/ui/render_ui pico/tools/render_ui.c pico/tools/render_ui_shots.c pico/tools/render_ui_screens.c $(find pico/src/app -name "*.c") -lm
build/ui/render_ui build/ui
mkdir -p screenshots/pico
python3 pico/tools/ppm2png.py screenshots/pico build/ui/*.ppm
